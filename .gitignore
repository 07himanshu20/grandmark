# ============================================================================
# GRANDMARK & ASSOCIATES — Next.js 15 / TypeScript / Tailwind
# ============================================================================

# ---------------------------------------------------------------- packages
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------ builds
/.next/
/out/
/build
/dist

# ------------------------------------------------------------- environment
# Anything holding a secret — form-service keys, SMTP credentials, analytics
# tokens. Commit .env.example instead, with the keys blank.
.env
.env.*
!.env.example

# ---------------------------------------------------------------- hosting
.vercel
.netlify

# -------------------------------------------------------------- typescript
*.tsbuildinfo
# regenerated by Next.js on every build
next-env.d.ts

# ------------------------------------------------------------------- tests
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# ------------------------------------ local QA output (see tools/shot.mjs)
/screenshots
/tools/screenshots
*.local.png

# -------------------------------------------------------------------- logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -------------------------------------------------------------------- misc
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# ============================================================================
# DELIBERATELY TRACKED — do not add these
#
#   public/img/            The firm's own photographs, logo and partner
#                          headshots (~3.7 MB). The site cannot build without
#                          them and they are not reproducible from npm.
#
#   src/content/data.json  All 70 pages of copy, compiled from the live site.
#                          Generated by tools/, but regenerating it requires
#                          scraping grandmarkca.com — so the build must not
#                          depend on network access.
#
#   tools/                 The content pipeline and QA scripts. Small, and the
#                          only record of how data.json was produced.
# ============================================================================
